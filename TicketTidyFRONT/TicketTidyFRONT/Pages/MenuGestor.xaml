<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TicketTidyFRONT.Pages.MenuGestor"
             Title="MenuGestor"
             BackgroundColor="LightSlateGray">
    <VerticalStackLayout>

        <VerticalStackLayout>
            <Border
                WidthRequest="150" HeightRequest="150" StrokeThickness="0"
                StrokeShape="RoundRectangle 75,75,75,75" 
                HorizontalOptions="Start" VerticalOptions="Start" Margin="20">
                <Image
                    Source="gestor_obra.jpg"
                    Aspect="AspectFill"
                    WidthRequest="150" HeightRequest="150" 
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Border
                WidthRequest="300"
                HeightRequest="100"
                Margin="0,10,20,30"
                StrokeThickness="0">
                <VerticalStackLayout VerticalOptions="Center">

                    <Label x:Name="lblId" FontAttributes="Bold"/>
                    <Label x:Name="lblNombre" FontAttributes="Bold"/>
                    <Label x:Name="lblEmail" FontAttributes="Bold"/>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

        <ListView ItemsSource="{Binding listaMenu}" x:Name="lstMenu" SelectionMode="None"
              ItemTapped="lstMenu_ItemTapped" SelectedItem="{Binding MenuTecnicoCLS}"
              >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <HorizontalStackLayout x:Name="itemLayout" Padding="10">
                            <Image Source="{Binding icono}" WidthRequest="30" HeightRequest="30"/>
                            <Label Margin="10,0,0,5" Text="{Binding nombre}" TextColor="Black"/>
                        </HorizontalStackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>