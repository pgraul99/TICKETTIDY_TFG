<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TicketTidyFRONT.Pages.AccionesGestor.IncidenciasByTecnico"
             Title="INCIDENCIAS POR TÉCNICO">

    <ScrollView>
        <VerticalStackLayout>


            <HorizontalStackLayout Background="Black" HeightRequest="60" Margin="0,0,0,30">
                <Grid ColumnDefinitions="*,2*,*">
                    <Image Source="{Binding image}" Grid.Column="0"></Image>
                    <Label Text="INCIDENCIAS POR TÉCNICO" TextDecorations="Underline" TextColor="White"
                    Grid.Column="1" VerticalOptions="CenterAndExpand" Margin="41,0"/>

                    <Border Grid.Column="2" WidthRequest="100">
                        <VerticalStackLayout>
                            <Label Text="Fecha" TextColor="White" HorizontalOptions="Center" Padding="5"/>
                            <Label Text="{Binding fecha}" TextColor="White" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </HorizontalStackLayout>

            

            <HorizontalStackLayout HorizontalOptions="Fill" Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto, Auto, *">
                    <Label Margin="8,0,0,0" Text="Seleccione técnico: " FontSize="18" VerticalOptions="Center" Grid.Column="0"
                FontAttributes="Bold"/>

                    <Border Background="White" 
                    Padding="5,0" 
                    Margin="15,0,5,0"
                    WidthRequest="165"
                        HeightRequest="40"
                    Stroke="Gray"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10" 
                    Grid.Column="1">
                        <HorizontalStackLayout>
                            <Picker HorizontalTextAlignment="End" x:Name="pickerTecnicos"
                                WidthRequest="125" VerticalOptions="Center"
                                    ItemsSource="{Binding Tecnicos}" ItemDisplayBinding="{Binding NombreUsuario}"
                                    SelectedItem="{Binding TecnicoSeleccionado}">
                                
                            </Picker>
                            <Image Source="down_icono.png" HeightRequest="20" WidthRequest="20">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer
                                        x:Name="pickerDesplegar"
                                        NumberOfTapsRequired="1"
                                        Tapped="pickerDesplegar_Tapped" />
                                </Image.GestureRecognizers>
                            </Image>
                        </HorizontalStackLayout>
                    </Border>

                    <Border
                        StrokeThickness="1"
                        Stroke="Gray"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="Gray"
                        WidthRequest="40"
                        HeightRequest="40"
                        Margin="5"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Grid.Column="2">

                        <ImageButton
                            x:Name="buscarBtn"
                            Source="search_icono.png"
                            Clicked="buscarBtn_Clicked"
                            BackgroundColor="Transparent"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0" />
                    </Border>

                </Grid>
            </HorizontalStackLayout>

            <BoxView BackgroundColor="DarkGray" HeightRequest="2" Margin="0,20,0,0"></BoxView>

            <!--CARGANDO INDICATOR-->

            <ActivityIndicator IsRunning="{Binding loading}"/>


            <Border Background="LightGray" Margin="3">
                <CollectionView ItemsSource="{Binding Incidencias}">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="2"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="Beige" Margin="5">
                                <Grid ColumnDefinitions=" Auto , *">

                                    <VerticalStackLayout Grid.Column="0" Padding="15,0">

                                        <Label Margin="0,10,0,0">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Id incidencia: " FontAttributes="Bold" />
                                                    <Span Text="{Binding Id}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label >
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Fecha apertura: " FontAttributes="Bold" />
                                                    <Span Text="{Binding FechaApertura, StringFormat='{0:dd-MM-yyyy}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Margin="0,0,0,10">
                                            <Label.FormattedText >
                                                <FormattedString>
                                                    <Span Text="Descripción incidencia: " FontAttributes="Bold" />
                                                    <Span Text="{Binding DescripcionIncidencia}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        

                                    </VerticalStackLayout>

                                    <Button  x:Name="verDetalleIncidencia" Clicked="verDetalleIncidencia_Clicked" 
                                        HeightRequest="40" WidthRequest="40" BackgroundColor="Gray" Margin="10"
                                        CommandParameter="{Binding Id}" VerticalOptions="CenterAndExpand" Grid.Column="1">
                                        <Button.ImageSource>
                                            <FileImageSource File="ojo_icono.png" />
                                        </Button.ImageSource>
                                    </Button>


                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </Border>

            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" IsVisible="false">
                <HorizontalStackLayout HorizontalOptions="Center">
                    <Image
                        Source="android_icon.png"
                        HeightRequest="50"
                        WidthRequest="50"/>

                    <Label
                        Text="TicketTidy.net"
                        FontSize="16"
                        VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>