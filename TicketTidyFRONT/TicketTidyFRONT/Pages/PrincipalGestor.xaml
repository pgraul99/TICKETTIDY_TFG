<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage     
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:TicketTidyFRONT.Pages"
             xmlns:local="clr-namespace:TicketTidyFRONT"
            x:Class="TicketTidyFRONT.Pages.PrincipalGestor"
                x:Name="flyoutPage"
                Title="Menú Gestor">

    <FlyoutPage.Flyout>
        <pages:MenuGestor></pages:MenuGestor>
    </FlyoutPage.Flyout>

    <FlyoutPage.Detail>
        <NavigationPage x:Name="Navigate">
            <x:Arguments>
                <pages:GenericaGestor></pages:GenericaGestor>
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>